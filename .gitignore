# Ignore everything by default
*

# Allow directories to be tracked (so we can access subdirectories)
!*/

# Allow .gitignore file itself
!.gitignore

# Allow README files
!README*
!readme*

# Allow STAT 200A lecture note PDFs in Notes folder
!Notes/
!Notes/*.pdf

# Allow STAT 200A lab PDFs in Labs folder
!Labs/
!Labs/*.pdf

# Ignore temporary and build files
*.tex
*.bbl
*.bbl-*
*.synctex.gz
*.unq
*.sty

# Ignore R project artifacts
.Rproj.user/
.Rhistory
.RData

